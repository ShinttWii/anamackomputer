Options -MultiViews -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /anamackomputer/

    # ── 1. File fisik yang ada di anamackomputer/ langsung ──
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 2. storage/ → amk-spk/public/storage/ (symlink) ──
    RewriteRule ^(storage/.+)$ amk-spk/public/$1 [L]

    # ── 3. Aset statis dari amk-spk/public/ ──
    # css/style.css → amk-spk/public/css/style.css
    RewriteCond %{DOCUMENT_ROOT}/anamackomputer/amk-spk/public/$1 -f
    RewriteRule ^(.+\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|webp))$ amk-spk/public/$1 [L]

    # ── 4. Semua route PHP → index.php bridge ──
    RewriteRule ^ index.php [L]
</IfModule>
